{
  "name": "jewel-cascade",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Jewel Cascade — a match-3 objective puzzle in a twilight jewel workshop, on the StarHermit engine.",
  "scripts": {
